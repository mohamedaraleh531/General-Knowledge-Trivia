<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/greeting1"
        android:layout_width="354dp"
        android:layout_height="38dp"
        android:gravity="center"
        android:text="General Knowledge Trivia"
        android:textColor="#F000"
        android:textSize="30dp"
        app:layout_constraintBottom_toTopOf="@+id/greeting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.093" />

    <TextView
        android:id="@+id/greeting"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="top|center_horizontal"
        android:padding="16dp"
        android:text="The Great Wall of China can be seen from space with the naked eye."
        android:textColor="#F000"
        android:textSize="25dp"
        app:layout_constraintBottom_toTopOf="@+id/imageView3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/greeting1" />

    <Button
        android:id="@+id/submit"
        android:layout_width="173dp"
        android:layout_height="132dp"
        android:gravity="center"
        android:text="True"
        android:textSize="50dp"
        android:backgroundTint="#09BC04"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/submit2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView3"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/submit2"
        android:layout_width="180dp"
        android:layout_height="129dp"
        android:gravity="center"
        android:text="False"
        android:textSize="50dp"
        android:backgroundTint="#E40C0C"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/submit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView3"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="389dp"
        android:layout_height="270dp"
        android:gravity="center"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@id/submit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/greeting"
        app:srcCompat="@drawable/greatwallofchina" />

    <Button
    android:id="@+id/emailButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Send Score by Email"
    android:visibility="gone"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_marginBottom="16dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>
